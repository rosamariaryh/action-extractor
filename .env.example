#this project currently only supports gemini
LLM_PROVIDER=gemini

# LLM settings
LLM_MAX_CONCURRENCY=8
LLM_MAX_RETRIES=3
#free-tier limit is 15 RPM for gemini
LLM_REQUESTS_PER_MINUTE=14

#connection to Gemini
GEMINI_API_KEY=
GEMINI_MODEL_NAME=
GEMINI_FALLBACK_MODEL=

# Optional for running the API outside Docker Compose with Phoenix locally.
# Docker Compose configures its internal Phoenix endpoint automatically.
# PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:4317
# Optional Phoenix API/UI endpoint for uploading evaluation annotations.
# Defaults to the collector hostname with port 6006 when a collector endpoint is set.
# PHOENIX_UI_ENDPOINT=http://127.0.0.1:6006
# Optional directory for timestamped per-run evaluation JSON reports.
# Defaults to evals/output/.
# EVAL_OUTPUT_DIR=evals/output

#phoenix
PHOENIX_ENABLE_AUTH=false
PHOENIX_SECRET=
PHOENIX_DEFAULT_ADMIN_INITIAL_PASSWORD=
PHOENIX_API_KEY=
